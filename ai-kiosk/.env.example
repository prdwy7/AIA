# ── Core ─────────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
TZ=Asia/Kolkata

# ── Database (PostgreSQL 17 + pgvector) ──────────────────────────────────────
# Central Postgres is published on host 55432 to avoid clashing with a system
# Postgres (Homebrew) that already binds localhost:5432 on dev machines.
DATABASE_URL=postgresql+psycopg://kiosk:kiosk@localhost:55432/ai_kiosk
EDGE_DATABASE_URL=postgresql+psycopg://kiosk:kiosk@localhost:5433/ai_kiosk_edge

# ── Object storage (SeaweedFS, S3-compatible; replaces MinIO) ────────────────
# MinIO stopped shipping free public images (Oct 2025); the dev stack now runs
# SeaweedFS (Apache-2.0) with an S3-compatible API and the same minioadmin creds.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MEDIA=kiosk-media
MINIO_BUCKET_BUNDLES=kiosk-bundles

# ── Identity (Keycloak) ──────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ai-kiosk
KEYCLOAK_CLIENT_ID=ai-kiosk-api

# ── MQTT (EMQX central / Mosquitto edge) ─────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_EDGE_BROKER_URL=mqtt://localhost:1884

# ── LLM (Ollama) ─────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
EDGE_LLM_MODEL=gemma3:12b-q5
EDGE_LLM_FALLBACK_MODEL=llama3.1:8b

# ── ASR chain ────────────────────────────────────────────────────────────────
ASR_PRIMARY=vaani-whisper        # ARTPARK-IISc/whisper-large-v3-vaani-telugu
ASR_FAST_FALLBACK=sravaani       # ARTPARK-IISc/SraVaani-1.0 (ONNX, CPU)
ASR_ONLINE=bhashini              # cross-check when online
ASR_CONFIDENCE_THRESHOLD=0.60    # below → confirmation gate / cross-check
BHASHINI_API_KEY=
BHASHINI_API_URL=https://api.bhashini.gov.in

# ── Model download (HuggingFace) ─────────────────────────────────────────────
KIOSK_MODELS_DIR=~/.cache/kiosk/models   # ASR model cache (see scripts/download_models.sh)
HF_ENDPOINT=                             # optional HuggingFace mirror

# ── TTS ──────────────────────────────────────────────────────────────────────
TTS_ENGINE=piper                 # piper (offline) → bhashini (online) → text-only

# ── Weather (IMD) ────────────────────────────────────────────────────────────
IMD_API_BASE=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_FORECAST_STALE_HOURS=6
IMD_NOWCAST_STALE_HOURS=2

# ── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# ── Sync / device ────────────────────────────────────────────────────────────
DEVICE_ID=kiosk-banavasi-01
SYNC_MTLS_CERT_PATH=/etc/kiosk/certs/device.crt
SYNC_MTLS_KEY_PATH=/etc/kiosk/certs/device.key
SYNC_CA_PATH=/etc/kiosk/certs/ca.crt

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
LOKI_URL=http://localhost:3100

# ── MLOps ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
DVC_REMOTE=local
