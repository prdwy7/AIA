# syntax=docker/dockerfile:1
# Edge device runtime (kiosk) — local core pipeline + device-agent + sync-agent
# with offline models. Build context: repo root.
#
# Production edge images bundle the signed model bundle (models/, KB, rules,
# prompt policy, lexicon) via the sync manifest (S19/S26); this is a lightweight
# skeleton for the edge simulator.
#
#   docker build -f infra/docker/Dockerfile.edge -t ai-kiosk/edge .
FROM ghcr.io/astral-sh/uv:0.12.1-python3.12 AS build
WORKDIR /repo
COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY services ./services
RUN uv sync --all-packages --no-dev --frozen

FROM python:3.12-slim AS runtime
WORKDIR /app
COPY --from=build /repo/.venv /app/.venv
COPY --from=build /repo/services /app/services
COPY --from=build /repo/models /app/models
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/services" \
    DEVICE_MODE=edge
EXPOSE 8000 11434
# device-agent starts Ollama first (avoids a per-request 3 s network probe), then
# core-api serves the local pipeline. See services/device-agent + core-api READMEs.
CMD ["sh", "-c", "ollama serve & exec uvicorn core_api.app:app --host 0.0.0.0 --port 8000"]
